*.bak
*.swp
*~
.DS_Store
Thumbs.db

# =====================
# 数据产物 / 运行临时文件
# =====================
# auto-annotator/outputs/ 内含示例 reviewed JSON，作为回归测试样本予以保留
# （如需忽略生成产物，可放开下面一行）：
# auto-annotator/outputs/*/
tmp/
*.png.tmp
# 代码库根部的生成可视化物（如 panels_viz.png），非源码
*_viz.png

# =====================
# 桌面工具打包（packaging/ 为可提交源码；其构建产物 build/dist 忽略）
# =====================
packaging/build/
packaging/dist/
packaging/__pycache__/

# =====================
# 编辑器 / IDE
# =====================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.code-workspace

# =====================
# 操作系统隐藏文件
# =====================
desktop.ini
$RECYCLE.BIN/

# =====================
# Node 等前端（备用，seam-preview 当前无依赖）
# =====================
node_modules/
dist/