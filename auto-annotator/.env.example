# ============================================================
#  auto-annotator 环境配置示例
#
#  复制本文件为 .env 并修改后使用：
#     Windows (PowerShell):  Copy-Item .env.example .env
#     Linux / macOS (bash):  cp .env.example .env
#
#  说明：当前 FastAPI 服务本身不主动读取这些变量（服务配置通过
#  uvicorn 命令行参数传入，见 README「启动说明」）。以下变量为
#  服务的运行参数预制入口，供启动脚本 / 未来版本统一读取。
#  请勿将真实的 .env 提交到 Git 仓库（.gitignore 已忽略）。
# ============================================================

# 服务监听地址：127.0.0.1=仅本机；0.0.0.0=局域网可访问
HOST=127.0.0.1

# 服务监听端口
PORT=8010

# 是否开启开发热重载（true / false）
RELOAD=false

# API 根路径（一般保持默认，不建议随意修改）
API_PREFIX=/api